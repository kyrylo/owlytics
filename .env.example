# Owlytics does not automatically read this file. Export these variables in
# your shell or use your service manager's environment-file support.
OWLYTICS_BIND=127.0.0.1:3000
OWLYTICS_DATABASE=data/owlytics.sqlite
OWLYTICS_URL=http://localhost:3000
# Leave empty for direct connections. Kamal requires its actual Docker network
# CIDR here, e.g. 172.18.0.0/16. Never trust 0.0.0.0/0 or ::/0.
OWLYTICS_TRUSTED_PROXIES=
# Initial password only: generate with `owlytics hash-password`.
# Settings changes are stored in SQLite and take precedence after a restart.
# OWLYTICS_PASSWORD_HASH='$argon2id$...'

# Kamal deployment configuration, used only by Kamal:
OWLYTICS_IMAGE=your-github-name/owlytics
OWLYTICS_SERVER=203.0.113.10
OWLYTICS_HOST=stats.example.com
OWLYTICS_REGISTRY=ghcr.io
OWLYTICS_REGISTRY_USERNAME=your-github-name
OWLYTICS_ARCH=amd64
# Seconds allowed for startup, including a one-time database upgrade.
OWLYTICS_DEPLOY_TIMEOUT=300
