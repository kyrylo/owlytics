# Owlytics does not automatically read this file. Export these variables in
# your shell or use your service manager's environment-file support.
OWLYTICS_BIND=127.0.0.1:3000
OWLYTICS_DATABASE=data/owlytics.sqlite
OWLYTICS_URL=http://localhost:3000
# Leave empty for direct connections. Kamal requires its actual Docker network
# CIDR here, e.g. 172.18.0.0/16. Never trust 0.0.0.0/0 or ::/0.
OWLYTICS_TRUSTED_PROXIES=
# Skip pageviews and engagement from visitors sending GPC (default: true).
# Set false to include otherwise eligible GPC traffic; DNT still suppresses it.
# Restart after changing; browsers revalidate /script.js on the next page load.
OWLYTICS_RESPECT_GPC=true
# Required on every start until a credential is saved in SQLite: generate with
# `owlytics hash-password`, passing a password from a hidden prompt through stdin.
# Missing or invalid hashes prevent startup only when no stored credential exists.
# Settings and `reset-password` save a credential in SQLite that takes precedence
# across restarts. This variable is then optional and ignored, even if invalid;
# changing it cannot override the stored password. Without a stored credential,
# changing this hash changes the password and invalidates existing sessions.
# OWLYTICS_PASSWORD_HASH='$argon2id$...'
# Recovery: `reset-password` needs the existing database, not this variable.
# It signs out all sessions and clears login throttling. See docs/administration.md
# for native and Docker commands using hidden prompts and stdin. Never pass
# the password as a command-line argument.

# Kamal deployment configuration, used only by Kamal:
OWLYTICS_IMAGE=your-github-name/owlytics
OWLYTICS_SERVER=203.0.113.10
OWLYTICS_HOST=stats.example.com
OWLYTICS_REGISTRY=ghcr.io
OWLYTICS_REGISTRY_USERNAME=your-github-name
OWLYTICS_ARCH=amd64
# Seconds allowed for startup, including a one-time database upgrade.
OWLYTICS_DEPLOY_TIMEOUT=300
